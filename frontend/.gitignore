# React build
build/

# Next.js
.next/
# dev/build 隔离目录 — `NEXT_DIST_DIR=.next-build npx next build` 写到这
.next-build/

# Node modules
node_modules/

# Logs
*.log
npm-debug.log*

# ESLint
.eslintcache

# IDE
.vscode/
.idea/
*.swp
*.swo

# TypeScript incremental build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Playwright test output (HTML reports, screenshots, traces).
# Never commit; regenerated on every `npx playwright test`.
test-results/
playwright-report/
playwright/.cache/

# Native dev runtime artifact — written by ops/dev/setup.sh so the
# hash-aware npm install can skip on no-op restarts. Always generated
# next to the frontend's package-lock.json.
.package-lock.sha256