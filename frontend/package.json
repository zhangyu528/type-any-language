{
  "name": "english-learning-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "next lint",
    "install": "node scripts/install.mjs",
    "dev:restart": "node scripts/restart.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test": "playwright test",
    "test:perf": "npm run build && E2E_PROD=1 playwright test landing.perf.spec.ts",
    "size": "next build && size-limit"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.1",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "@use-gesture/react": "^10.3.1",
    "face-api.js": "^0.22.2",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.15.0",
    "lucide-react": "^0.542.0",
    "maath": "^0.10.8",
    "matter-js": "^0.20.0",
    "motion": "^12.43.0",
    "next": "^15.0.0",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.30.4",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@size-limit/file": "^11.2.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.5.25",
    "size-limit": "^11.2.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3"
  },
  "size-limit": [
    {
      "name": "Landing page (first load JS, gzipped)",
      "path": ".next/static/chunks/app/page.js",
      "limit": "1500 KB",
      "gzip": true
    },
    {
      "name": "ogl (WebGL library, gzipped)",
      "path": "node_modules/ogl/src/index.js",
      "limit": "60 KB",
      "gzip": true
    }
  ]
}
