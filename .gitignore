# Environment
.env
.env.local
.env.*.local
.env.dev

# Runtime DB credentials — local postgres password + DATABASE_URL files
# (chmod 600). Written by ops/cvm/db-credentials/init.sh on first host
# bootstrap (or run.sh's write_secrets() in legacy paths). Never commit:
# each host generates its own on first start.
.dbcreds/

# Per-call artifact download dir used by cms/secrets/fetch_secrets.sh.
# Bound to the script's lifetime via `trap rm -rf RETURN`, but the
# ignore entry is belt-and-suspenders against a crash mid-fetch.
/.fetch-*

# Dev-only per-host state. Machine-local data that's never committed.
# The .local/ tree has multiple subdirs, one per stack, each owning its
# own runtime state (PID + log files). The `.docker-postgres-data/`
# sibling is the docker postgres container's bind-mount target; it
# lives at root (not under .local/) because it's managed by docker, not
# by any script in dev-tools/.
#
#   - .docker-postgres-data/  — bind-mounted postgres data dir (created
#                             on first `docker compose up` of the db
#                             service). Persistent across container
#                             restarts. Operator-backup-friendly
#                             (it's just a directory).
#   - .local/native/pids/     — backend/frontend PID files written by
#                             dev-tools/native.sh (main dev stack;
#                             empty when no service is running).
#   - .local/native/logs/     — backend/frontend stdout+stderr tail
#                             files written by dev-tools/native.sh.
#   - .local/monitor/pids/    — monitor server + vite PIDs written by
#                             monitor/dev.sh (monitor stack only).
#   - .local/monitor/logs/    — monitor server.log + vite.log written
#                             by monitor/dev.sh.
#   - .dev-db-name           — written by bootstrap_tencent.sh in the
#                             mode-2 (per-branch) era; no longer
#                             written. Kept here in case it's still
#                             present on legacy hosts.
.local/
.docker-postgres-data/

# OS
.DS_Store
Thumbs.db

# Agent / scratch — local temp folders written by automation
# (Playwright screenshot runs, click-recording scripts, etc.).
# These live INSIDE the repo so they ARE visible to git;
# without this entry they show up as untracked every time.
# Matches the repo-internal path "tmp/" — does NOT affect OS
# /tmp (which is outside the repo and git can't see anyway).
# Naming convention: tmp/screenshots/*.png, tmp/<other>/.
tmp/

# IDE
.vscode/
.idea/
.claude/

# Docker
.docker/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
# Python setuptools' build/ (root-only — do NOT generalize to all
# build/ directories; e.g. ops/prod/build/ holds our image build
# scripts and MUST be tracked).
/build/
.venv/
venv/
ENV/
.pytest_cache/

# Node
node_modules/
npm-debug.log*

# Next.js build output (root-level; frontend/.gitignore covers frontend/.next/)
.next/

# Playwright test output (root-level; frontend/.gitignore covers frontend/test-results/)
test-results/

# Logs
*.log
logs/

# Dev-only per-host state. Includes:
#   - .dev/data/postgres/ — docker postgres bind-mount (re-creatable
#                            from cms/content/ via make dev-import-content)
#   - .dev/*.pid          — host-native dev server PIDs
# Always re-creatable, never commit.
/dev/

# Stitch (Google Labs design tool) — local snapshot scratch.
# Generated by stitch-skills plugin when generating screens / capturing
# design tokens; never part of the app source.
.stitch/

# Workbuddy local scratch. Per-session notes / memory the workbuddy
# helper writes alongside the working tree; never part of the app source.
.workbuddy/

.env.db
