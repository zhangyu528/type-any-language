#!/usr/bin/env bash
#
# dev — dev subsystem entry point (Win/macOS/Linux).
#
# Wraps the host-native dev loop. backend (uvicorn --reload) + frontend
# (next dev) both run on the host as plain processes; the dev db lives in
# docker (postgres:15-alpine). `bash dev/dev run` brings both up in the
# foreground — Ctrl+C stops them cleanly, stack traces show in the same
# terminal, reload events stream live.
#
# The old daemonized model (start/stop/status/logs + .pid/.log files)
# is gone. If you need to leave the dev loop running in the background,
# use a terminal multiplexer (tmux / Windows Terminal tabs) — don't add
# a daemonized mode back to this script.
#
# Three-platform zero-install prereqs:
#   - macOS / Linux         : bash ships with the OS
#   - Windows (Git Bash)    : bash.exe ships with Git for Windows
#   - Windows (PowerShell/cmd): open Git Bash first; raw PowerShell
#                               `bash` is a WSL launcher and may fail.
#
# Usage: bash dev/dev <subcommand>

set -e

# ─── Locate project root (dev/dev lives at dev/, parent = repo root) ───────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR" && cd .. && pwd)"
cd "$PROJECT_DIR"

CLI_DIR="$SCRIPT_DIR/cli"

SUBCMD="${1:-help}"
shift 2>/dev/null || true

case "$SUBCMD" in
  # ---- 主入口 ----
  run)                bash "$CLI_DIR/run.sh"            "$@" ;;

  # ---- 一次性 / 数据 ----
  setup)              bash "$CLI_DIR/setup.sh"          "$@" ;;
  doctor)             bash "$CLI_DIR/doctor.sh"         "$@" ;;
  migrate)            bash "$CLI_DIR/migrate.sh"        "$@" ;;
  import|import-content)
                      bash "$CLI_DIR/import.sh"         "$@" ;;

  # ---- CMS 内容管线 (原 Makefile cms-*) ----
  cms-vocab)          bash cms/scripts/staging.sh vocab        "$@" ;;
  cms-sentences)      bash cms/scripts/staging.sh sentences    "$@" ;;
  cms-audio)          bash cms/scripts/staging.sh audio        "$@" ;;
  cms-staging-doctor) bash cms/scripts/staging.sh doctor       "$@" ;;
  cms-run)            bash cms/run.sh                          "$@" ;;

  # ---- 帮助 ----
  help|--help|-h)
    cat <<'USAGE'
Usage: bash dev/dev <command> [args]

Service lifecycle:
  run [backend|frontend]  Foreground dev loop (uvicorn + next dev).
                          Ctrl+C to stop. Stack traces and reload events
                          appear in this terminal.

One-shot / data:
  setup                   First-time install: deps + start docker db
  doctor                  Preflight: docker / compose / host python+node / db
  migrate                 Apply pending schema migrations to docker postgres
  import [args]           UPSERT cms/content/ into docker postgres
                          (alias: import-content)

CMS content pipeline (runs on the CMS host):
  cms-vocab               CSVs -> cms/content/vocabulary/<lib>.json (Extract)
  cms-sentences           OpenAI -> cms/content/sentences/<lib>.jsonl
  cms-audio               Tencent TTS -> fill audio_url in cms/content/sentences/*
  cms-staging-doctor      CMS env + Python deps preflight
  cms-run                 Full CMS pipeline (vocab + sentences + audio, no db import)

Other:
  help                    Show this message

Examples:
  bash dev/dev run                   # both backend + frontend
  bash dev/dev run backend           # only backend
  bash dev/dev doctor
  bash dev/dev migrate
  bash dev/dev import

Cross-platform:
  macOS  / Linux        bash dev/dev run
  Windows (Git Bash)    bash dev/dev run
  Windows (PowerShell/cmd)  Open a Git Bash terminal first
USAGE
    ;;

  *)
    echo "Unknown command: $1" >&2
    echo "Run 'bash dev/dev help' for usage." >&2
    exit 2
    ;;
esac