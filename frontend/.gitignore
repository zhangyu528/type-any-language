# React build
build/

# Next.js
.next/
# Dev server cache — `next dev` writes to .next-dev (or .next-dev2,
# .next-dev3… if earlier ports were busy and Next picked a new dir).
# Wildcard covers any suffix Next.js appends on port collision.
.next-dev*/
# dev/build 隔离目录 — `NEXT_DIST_DIR=.next-build npx next build` 写到这
.next-build/

# Node modules
node_modules/

# Logs
*.log
npm-debug.log*

# ESLint
.eslintcache

# IDE
.vscode/
.idea/
*.swp
*.swo

# TypeScript incremental build cache
tsconfig.tsbuildinfo
*.tsbuildinfo

# Agent scratch scripts — `*-tmp.mjs` (e.g. click-recording
# helpers, exploratory Playwright probes). Suffix `-tmp.mjs`
# is the convention for "I generated this just now, don't ship
# it". Pattern only matches this suffix, not legitimate scripts.
*-tmp.mjs

# One-off debug / snapshot / measurement scripts generated during
# UI development. These are exploratory Playwright probes, not
# production code — never commit.
scripts/debug-*.mjs
scripts/snap-*.mjs
scripts/check-*.mjs
scripts/measure-*.mjs
scripts/inspect-*.mjs
scripts/test-*.mjs

# Project uses npm (package-lock.json), not pnpm.
pnpm-lock.yaml

# Playwright test output (HTML reports, screenshots, traces).
# Never commit; regenerated on every `npx playwright test`.
test-results/
playwright-report/
playwright/.cache/

# Native dev runtime artifact — written by ops/dev/setup.sh so the
# hash-aware npm install can skip on no-op restarts. Always generated
# next to the frontend's package-lock.json.
.package-lock.sha256