# frontend/.dockerignore — exclude everything that shouldn't be baked
# into the prod image. Dockerfile does `COPY . .` so this is the only
# thing standing between the host working tree and the image context.

# ── Build artifacts (regenerated inside the container) ───────────────────
node_modules/
.next/
out/
build/

# ── VCS metadata ─────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Secrets — never bake into any image ──────────────────────────────────
.env
.env.*
!.env.example*

# ── Editor / IDE / OS junk ───────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# ── Logs and runtime artifacts ───────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ── Test / coverage output ───────────────────────────────────────────────
coverage/
.nyc_output/

# ── TypeScript incremental build cache ───────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Native dev artifact (written by ops/dev/setup.sh) ──────────────────
.package-lock.sha256
